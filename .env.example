# =============================================================================
# EN: matrix-federated-gcp — environment template
# RU: matrix-federated-gcp — шаблон переменных окружения
# =============================================================================
# EN: Recommended: generate .env with scripts/setup-env.py instead of editing
# EN: this template manually.
# RU: Рекомендуется генерировать .env через scripts/setup-env.py, а не
# RU: редактировать этот шаблон вручную.
#
# EN: .env contains secrets and MUST NOT be committed to Git.
# RU: .env содержит секреты и НЕ ДОЛЖЕН попадать в Git.
# =============================================================================

# EN: Compose / locale
# RU: Compose / локаль
COMPOSE_PROJECT_NAME=matrix_federated
COMPOSE_PROFILES=admin
TZ=UTC

# EN: Custom images built by this repository and published to GHCR.
# RU: Собственные образы этого репозитория, публикуемые в GHCR.
GHCR_OWNER=CHANGE_ME_GITHUB_OWNER
CONFIG_IMAGE_TAG=main
HAPROXY_IMAGE_TAG=main

# EN: Public DNS zone, GCP static IP and TLS automation.
# RU: Публичная DNS-зона, статический IP GCP и автоматизация TLS.
PUBLIC_DOMAIN=example.com
PUBLIC_IP=CHANGE_ME_PUBLIC_IP
ACME_EMAIL=
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=CHANGE_ME_CLOUDFLARE_ZONE_ID

# EN: Public Matrix endpoints. setup-env.py derives these from PUBLIC_DOMAIN.
# RU: Публичные Matrix endpoints. setup-env.py вычисляет их из PUBLIC_DOMAIN.
SYNAPSE_SERVER_NAME=matrix.example.com
SYNAPSE_PUBLIC_BASEURL=https://matrix.example.com
ELEMENT_WEB_URL=https://element.example.com
MAS_PUBLIC_BASEURL=https://mas.example.com/
LIVEKIT_PUBLIC_URL=wss://rtc.example.com
LIVEKIT_JWT_SERVICE_URL=https://rtc-jwt.example.com

# EN: Runtime images. Upgrade deliberately, one component at a time.
# RU: Runtime-образы. Обновляйте осознанно, по одному компоненту за раз.
ACME_IMAGE=neilpang/acme.sh:3.1.3
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.157.1
MAS_IMAGE=ghcr.io/element-hq/matrix-authentication-service:1.21.0
MAS_DEBUG_IMAGE=ghcr.io/element-hq/matrix-authentication-service:1.21.0-debug
ELEMENT_WEB_IMAGE=ghcr.io/element-hq/element-web:v1.12.24
ELEMENT_ADMIN_IMAGE=oci.element.io/element-admin:latest
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.4
LK_JWT_IMAGE=ghcr.io/element-hq/lk-jwt-service:0.5.0

# EN: Synapse
# RU: Synapse
SYNAPSE_REPORT_STATS=no
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_NAME=synapse
SYNAPSE_DB_PASSWORD=CHANGE_ME_RANDOM_SECRET
USER_DIRECTORY_SEARCH_ALL=true
USER_DIRECTORY_EXCLUDE_REMOTE=true

# EN: Matrix Authentication Service (MAS)
# RU: Matrix Authentication Service (MAS)
MAS_DB_USER=mas
MAS_DB_NAME=mas
MAS_DB_PASSWORD=CHANGE_ME_RANDOM_SECRET
MAS_SHARED_SECRET=CHANGE_ME_RANDOM_SECRET
MAS_BRAND_NAME=My Matrix
MAS_REGISTRATION_TOKEN_REQUIRED=true
MAS_EMAIL_REQUIRED=false
MAS_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8,fd00::/8,::1/128

# EN: Initial administrator. Created only on a fresh MAS config volume.
# RU: Начальный администратор. Создаётся только на чистом MAS config volume.
MAS_ADMIN_USER=admin
MAS_ADMIN_PASSWORD=CHANGE_ME_RANDOM_SECRET
MAS_ADMIN_DISPLAY_NAME=Administrator

# EN: Element Web
# RU: Element Web
ELEMENT_BRAND=Element
ELEMENT_DEFAULT_THEME=light

# EN: MatrixRTC / LiveKit
# RU: MatrixRTC / LiveKit
LIVEKIT_KEY=CHANGE_ME_LIVEKIT_KEY
LIVEKIT_SECRET=CHANGE_ME_RANDOM_SECRET
LIVEKIT_UDP_PORT_START=50000
LIVEKIT_UDP_PORT_END=50050
LIVEKIT_LOG_LEVEL=info

# EN: Redis state used by lk-jwt-service
# RU: Redis state для lk-jwt-service
REDIS_PASSWORD=CHANGE_ME_RANDOM_SECRET

# EN: HAProxy virtual hosts. setup-env.py derives these from PUBLIC_DOMAIN.
# RU: Виртуальные hosts HAProxy. setup-env.py вычисляет их из PUBLIC_DOMAIN.
HAPROXY_MATRIX_HOST=matrix.example.com
HAPROXY_MAS_HOST=mas.example.com
HAPROXY_ELEMENT_HOST=element.example.com
HAPROXY_PANEL_HOST=panel.example.com
HAPROXY_RTC_JWT_HOST=rtc-jwt.example.com
HAPROXY_RTC_HOST=rtc.example.com